{
  "name": "scala-kudu-impala-kafka-spark",
  "image": "mcr.microsoft.com/devcontainers/java:3-11-trixie",
  "features": {
    "ghcr.io/devcontainers/features/java:11": {
      "version": "none",
      "installMaven": "true",
      "installGradle": "false"
    },
    "ghcr.io/devcontainers-contrib/features/scala-sdkman:2": {
      "version": "2.12.21"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "scalameta.metals",
        "vscjava.vscode-java-pack",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "mvn -B -DskipTests compile",
  "remoteUser": "vscode"
}