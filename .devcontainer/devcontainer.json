{
  "name": "scala-kudu-impala-kafka-spark",
  "dockerComposeFile": "docker-compose-kudu.yml",
  "service": "scala-kudu-impala-kafka-spark",
  "workspaceFolder": "workspace",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "11",
      "installMaven": "true",
      "installGradle": "false"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "scalameta.metals",
        "vscjava.vscode-java-pack",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "editor.formatOnSave": true
      }
    }
  },
  "postCreateCommand": "mvn -B -DskipTests compile",
  "remoteUser": "vscode"
}